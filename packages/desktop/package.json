{
	"name": "@argon/desktop",
	"version": "0.1.4",
	"private": true,
	"type": "module",
	"description": "Argon desktop application",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"pack": "npm run build && node scripts/fetch-search-tools.mjs && electron-builder --dir",
		"dist": "npm run build && node scripts/fetch-search-tools.mjs && electron-builder",
		"typecheck": "tsc -p tsconfig.json",
		"icons": "electron scripts/icons.mjs"
	},
	"dependencies": {
		"@argon/backend": "*",
		"@argon/shared": "*"
	},
	"devDependencies": {
		"electron": "45.5.0",
		"electron-vite": "6.0.0",
		"electron-builder": "26.18.0"
	},
	"build": {
		"appId": "dev.argon.desktop",
		"productName": "Argon",
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"files": [
			"out/**/*",
			"resources/**/*",
			"package.json"
		],
		"asar": true,
		"asarUnpack": [
			"node_modules/**/*",
			"out/main/backend.js",
			"out/main/chunks/**/*"
		],
		"npmRebuild": false,
		"mac": {
			"icon": "build/Argon.icon",
			"target": [
				"dmg"
			],
			"category": "public.app-category.developer-tools"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"linux": {
			"target": [
				"AppImage"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true
		},
		"extraResources": [
			{
				"from": ".search-tools",
				"to": "search-tools"
			}
		]
	}
}
