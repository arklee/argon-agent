{
	"name": "argon",
	"private": true,
	"version": "0.1.0",
	"description": "Argon — a GUI agent built on the pi coding agent",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:backend": "npm run dev -w @argon/backend",
		"dev:web": "npm run dev -w @argon/web",
		"build": "npm run build -w @argon/web",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"smoke": "tsx scripts/smoke.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"postinstall": "patch-package",
		"vendor": "node scripts/vendor.mjs",
		"dev:desktop": "npm run dev -w @argon/desktop",
		"build:desktop": "npm run build -w @argon/desktop",
		"pack:desktop": "npm run pack -w @argon/desktop",
		"dist:desktop": "npm run dist -w @argon/desktop",
		"smoke:desktop": "node scripts/desktop-smoke.mjs"
	},
	"overrides": {
		"magpie-pi": {
			"@earendil-works/pi-ai": "1.7.0",
			"@earendil-works/pi-coding-agent": "1.7.0"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"patch-package": "^8.0.1",
		"typescript": "^5.9.0"
	}
}
