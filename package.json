{
	"name": "argon",
	"private": true,
	"version": "0.1.0",
	"description": "Argon — a GUI agent built on the pi coding agent",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:backend": "npm run dev -w @argon/backend",
		"dev:web": "npm run dev -w @argon/web",
		"build": "npm run build -w @argon/web",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"typescript": "^5.9.0"
	}
}
